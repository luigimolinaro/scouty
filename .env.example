# Utenti: nome:password:ruolo separati da ;  (ruolo = coach oppure scout)
# Puoi mettere più allenatori e più scout.
USERS=mister:CambiaQuestaPassword1:coach;scout1:CambiaQuestaPassword2:scout

# 1 se usi HTTPS (Caddy o altro proxy), 0 se provi in http su rete locale
COOKIE_SECURE=0

# 1 se l'app sta dietro un proxy (Caddy/nginx): serve per il limite tentativi di login
TRUST_PROXY=0

# Dominio per HTTPS automatico con Caddy (profilo https)
DOMAIN=scout.example.it

# Secondi senza segnale dopo i quali lo scout è considerato "libero"
LOCK_TTL=90

# Partite conservate nello storico
HISTORY_SIZE=6

# Utente/gruppo con cui gira il container (default 1000:1000). La cartella data/ deve
# appartenere a loro. Cambiali solo se data/ è di un altro utente (es. www-data = 33:33).
# DATA_UID=1000
# DATA_GID=1000
